# Contact form backend (see worker/README.md). These are public values that get
# baked into the page at build time. Copy to .env for local development.

# Local Worker started with `npm run dev` in worker/. In production this is the
# deployed Worker's URL, e.g. https://portfolio-contact.<subdomain>.workers.dev/contact
PUBLIC_CONTACT_API_URL=http://localhost:8787/contact

# Cloudflare's always-pass test site key. Production uses the widget's real site key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
