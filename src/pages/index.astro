---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import Rosettes from '../components/Rosettes.astro';
import JourneyGraph, { type JourneyEvent } from '../components/JourneyGraph.astro';
import { site, metrics } from '../data/site';
import { url } from '../lib/url';
import clearpathMark from '../assets/logo/clearpath-mark.png';
import wfsMark from '../assets/logo/wfs-mark.png';
import heroPhoto from '../assets/photos/hero-coffee.jpg';
import storyPhoto from '../assets/photos/story-hoodie.jpg';
import graduationPhoto from '../assets/photos/story-graduation.jpg';

const featured = [
  {
    name: 'ClearPath Virtual Health',
    role: 'Lead Software Engineer · MedManage Solutions',
    href: '/projects/clearpath',
    live: 'https://clearpathvirtualhealth.com/',
    liveLabel: 'clearpathvirtualhealth.com',
    mark: clearpathMark,
    text: 'A production HIPAA-compliant chronic care management and remote patient monitoring platform, architected from the ground up across four role-based portals.',
    tags: ['React', 'AWS', 'HIPAA', 'Medicare billing'],
  },
  {
    name: 'Union Workforce Ecosystem',
    role: 'Lead Developer · Workforce Systems',
    href: '/projects/workforce-systems',
    live: 'https://workforcesystems.net/',
    liveLabel: 'workforcesystems.net',
    mark: wfsMark,
    text: 'A five-portal platform, built for a union, that unifies dispatch, dues, grievances, training, and benefits into one system of record for its members, contractors, and staff.',
    tags: ['Platform design', 'Design system', 'Node.js tooling'],
  },
] as const;

const journey: JourneyEvent[] = [
  { when: 'Feb 2001', what: 'Born and raised in the East Bay', lane: 0, kind: 'start' },
  { when: '2020 – 2023', what: 'Los Medanos College · Honor Roll', lane: 0 },
  { when: 'Jan 2024', what: 'SFSU · B.S. Computer Science, Minor in Persian Studies', lane: 0 },
  { when: 'Sep 2025', what: 'Lead Software Engineer, MedManage Solutions', lane: 1, kind: 'branch' },
  { when: 'Dec 2025', what: 'Software Engineer Intern, Optimyzi', lane: 2, kind: 'branch' },
  { when: 'Jun 2026', what: 'Optimyzi internship complete', lane: 2, kind: 'end' },
  { when: 'Jul 2026', what: 'Lead Developer, Workforce Systems', lane: 3, kind: 'branch' },
  { when: 'Aug 2026', what: 'Graduated from SFSU · Honor Roll + Dean’s List', lane: 0, kind: 'end' },
  { when: 'Today', what: 'Leading ClearPath and Workforce Systems', lane: 1, kind: 'now', lanes: [1, 3] },
];

const strengths = [
  {
    icon: 'lock',
    title: 'Regulated systems',
    text: 'HIPAA-compliant session management, MFA, audit logging, and RBAC, built so clinical teams can trust the software with patient care.',
  },
  {
    icon: 'layers',
    title: 'Frontend to cloud',
    text: 'React interfaces and AWS infrastructure (S3, CloudFront, ECS Fargate) shipped through automated CI/CD pipelines.',
  },
  {
    icon: 'compass',
    title: 'Technical leadership',
    text: 'Leading a distributed engineering team and working directly with clinicians and union leadership to turn workflows into products.',
  },
] as const;
---

<Base>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="reveal" style="--delay: 0.05s">
          Built from the ground up. <span class="highlight">Like everything else.</span>
        </h1>
        <p class="lead reveal" style="--delay: 0.1s">
          {site.name} architected <strong>ClearPath Virtual Health</strong>, a HIPAA-compliant
          chronic care platform, and leads development at <strong>Workforce Systems</strong>, building
          digital infrastructure for the unions that keep the Bay Area working.
        </p>
        <div class="btn-row reveal" style="--delay: 0.15s">
          <a href={url('/projects')} class="btn btn--primary">
            See his work <Icon name="arrow-right" />
          </a>
          <a href={url('/about')} class="btn btn--ghost">His story</a>
        </div>
      </div>

      <div class="hero__visual reveal" style="--delay: 0.1s">
        <div class="portrait">
          <div class="portrait__frame">
            <Image
              src={heroPhoto}
              alt="Sām Kazemi at a café table, smiling, with an iced coffee"
              widths={[420, 640, 840]}
              sizes="(min-width: 960px) 420px, calc(100vw - 32px)"
              loading="eager"
              fetchpriority="high"
              class="portrait__img"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="metrics" aria-label="Impact at MedManage Solutions">
    <div class="container">
      <ul class="metrics__grid">
        {
          metrics.map((m, i) => (
            <li class="reveal" style={`--delay: ${i * 0.06}s`}>
              <span class="metrics__value">{m.value}</span>
              <span class="metrics__label">{m.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Featured work</p>
        <h2>Software people depend on every day</h2>
        <p class="lead">
          Two platforms, two industries, one principle: the software has to work for the people on
          the other side of the screen: patients, care coordinators, laborers, and the organizations
          that serve them.
        </p>
      </div>

      <div class="grid grid--2">
        {
          featured.map((p, i) => (
            <article class="work card reveal" style={`--delay: ${i * 0.08}s`}>
              <div class="work__top">
                <span class="work__mark">
                  <Image src={p.mark} alt="" widths={[48, 96, 144]} sizes="48px" />
                </span>
                <a class="work__live" href={p.live} target="_blank" rel="noopener">
                  {p.liveLabel} <Icon name="arrow-up-right" size={14} />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </div>
              <h3>{p.name}</h3>
              <p class="work__role">{p.role}</p>
              <p>{p.text}</p>
              <ul class="tag-list">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
              <a class="work__link" href={url(p.href)}>
                Read the case study <Icon name="arrow-right" size={18} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt story">
    <div class="container story__grid">
      <figure class="story__photo reveal">
        <Image
          src={storyPhoto}
          alt="Sām Kazemi in a green zip hoodie and Oakland A's cap under a row of arches"
          widths={[400, 600, 900]}
          sizes="(min-width: 900px) 440px, calc(100vw - 32px)"
          class="story__img"
        />
      </figure>

      <div class="story__text reveal">
        <p class="eyebrow">His story</p>
        <h2>From Antioch to architecting health tech</h2>
        <p class="lead">
          The son of Iranian immigrants, Sām grew up in Antioch, California, where he saw what gang
          violence did to friends and his community. He chose a different path: community college, a transfer to San Francisco State, and a
          career building software that matters.
        </p>
        <p class="muted">
          Along the way he reclaimed his name, Sām, and made his Iranian heritage central to who he
          is, as an engineer and as someone committed to his community.
        </p>
        <a href={url('/about')} class="btn btn--ghost">
          Read his story <Icon name="arrow-right" />
        </a>
      </div>

      <JourneyGraph events={journey} class="story__journey reveal" style="--delay: 0.1s" />

      <figure class="story__photo story__photo--grad reveal" style="--delay: 0.1s">
        <div class="story__backdrop" aria-hidden="true">
          <Rosettes id="story-rosettes" size={44} />
        </div>
        <Image
          src={graduationPhoto}
          alt="Sām Kazemi with classmates in purple caps and gowns at the SFSU commencement at Oracle Park, holding his diploma"
          widths={[400, 600, 720]}
          sizes="(min-width: 900px) 440px, calc(100vw - 32px)"
          class="story__img"
        />
        <figcaption class="story__chip story__chip--right">
          <Icon name="graduation-cap" size={16} /> SFSU · Class of 2026
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">What he brings</p>
        <h2>Engineering for high-stakes environments</h2>
      </div>
      <div class="grid grid--3">
        {
          strengths.map((s, i) => (
            <div class="card reveal" style={`--delay: ${i * 0.08}s`}>
              <span class="icon-badge">
                <Icon name={s.icon} />
              </span>
              <h3 class="strength__title">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          ))
        }
      </div>
      <p class="center-link reveal">
        <a href={url('/skills')}>See all skills and tools <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 96px);
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 30%, var(--gold-tint), transparent 50%),
      radial-gradient(circle at 5% 90%, var(--gold-tint), transparent 40%);
    pointer-events: none;
  }

  /* On the dark background the gold glow reads as orange blotches; keep it matte. */
  :global(:root[data-theme='dark']) .hero__glow {
    display: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
    }
  }

  .hero h1 {
    max-width: 14ch;
  }

  @media (min-width: 600px) {
    .hero h1 .highlight {
      white-space: nowrap;
    }
  }

  .hero h1 .highlight {
    padding-bottom: 0;
    background: none;
    animation: none;
  }

  .hero .lead {
    max-width: 54ch;
    margin: 20px 0 30px;
  }

  .hero .lead strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .portrait {
    position: relative;
    width: min(100%, 420px);
  }

  .portrait__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: 24px;
    background: var(--bg-alt);
    box-shadow: 0 30px 50px -24px rgba(90, 61, 12, 0.45);
  }

  .portrait__frame :global(.portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .metrics {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .metrics__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metrics__grid li {
    display: grid;
    gap: 4px;
    padding: 28px 12px;
    text-align: center;
  }

  .metrics__grid li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .metrics__grid li:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .metrics__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .metrics__grid li {
      padding: 36px 20px;
    }
    .metrics__grid li:nth-child(-n + 2) {
      border-bottom: 0;
    }
    .metrics__grid li:not(:last-child) {
      border-right: 1px solid var(--line);
    }
  }

  .metrics__value {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--gold-strong);
    line-height: 1.1;
  }

  .metrics__label {
    max-width: 24ch;
    margin: 0 auto;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 4px solid var(--gold);
  }

  .work__mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
  }

  .work__mark :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .work__live {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .work h3 {
    font-size: 1.5rem;
    margin-bottom: 2px;
  }

  .work__role {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .work > p:not(.work__role) {
    color: var(--ink-soft);
  }

  .work .tag-list {
    margin-bottom: 24px;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-weight: 600;
    text-decoration: none;
  }

  .story__grid {
    display: grid;
    gap: 48px;
    grid-template-areas:
      'text'
      'photo'
      'journey'
      'grad';
  }

  .story__text {
    grid-area: text;
  }

  .story__photo {
    grid-area: photo;
    position: relative;
    width: min(100%, 440px);
    margin: 0 0 18px;
  }

  .story__photo--grad {
    grid-area: grad;
    /* Leave room for the backdrop offset so it stays inside the page. */
    width: min(100% - 18px, 440px);
    margin-top: 18px;
  }

  /* Hoodie photo: gold outline offset down-left. */
  .story__photo:not(.story__photo--grad)::before {
    content: '';
    position: absolute;
    inset: -14px 14px 14px -14px;
    border: 2px solid var(--gold-bright);
    border-radius: 24px;
  }

  /* Graduation photo: polished-gold rosette panel offset up-right, the mirror image. */
  .story__backdrop {
    position: absolute;
    inset: -18px -18px 18px 18px;
    overflow: hidden;
    border-radius: 24px;
    background: var(--gold-metal);
  }

  .story__backdrop :global(.rosettes) {
    color: rgba(31, 26, 18, 0.12);
  }

  .story__photo :global(.story__img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .story__chip {
    position: absolute;
    bottom: -18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .story__chip :global(svg) {
    color: var(--gold);
  }

  .story__chip--right {
    right: 24px;
  }

  /* Rendered by JourneyGraph, outside this file's style scope. */
  .story__grid :global(.story__journey) {
    grid-area: journey;
  }

  /* Zigzag: photo | text, then timeline | photo. */
  @media (min-width: 900px) {
    .story__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'photo text'
        'journey grad';
      column-gap: 80px;
      row-gap: 96px;
      align-items: center;
    }
    .story__photo--grad {
      justify-self: end;
    }
  }

  .story .lead {
    margin-bottom: 14px;
  }

  .story .muted {
    margin-bottom: 28px;
  }


  .strength__title {
    margin-top: 18px;
  }

  .center-link {
    margin: 36px 0 0;
    text-align: center;
    font-weight: 600;
  }

  .center-link a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
</style>
