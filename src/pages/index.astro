---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Metrics from '../components/home/Metrics.astro';
import Projects from '../components/home/Projects.astro';
import Skills from '../components/home/Skills.astro';
import Reviews from '../components/home/Reviews.astro';
import Resume from '../components/home/Resume.astro';
import Contact from '../components/home/Contact.astro';
---

<!-- One long page; the old /projects, /skills, /reviews, /resume and /contact URLs
     redirect to these sections (see astro.config.mjs). -->
<Base>
  <Hero />
  <Metrics />
  <Projects />
  <Skills />
  <Reviews />
  <Resume />
  <Contact />
</Base>
