---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/site';
import { url } from '../lib/url';

const caseStudies: Record<string, string> = {
  'MedManage Solutions': '/projects/clearpath',
  'Workforce Systems (WFS)': '/projects/union-workforce',
};
---

<Base
  title="Experience"
  description="Sām Kazemi's professional experience: Lead Software Engineer at MedManage Solutions and Lead Engineer at Workforce Systems."
>
  <PageHeader
    eyebrow="Experience"
    title="Leading engineering where the stakes are real"
    lead="From HIPAA-regulated clinical software to platforms for organized labor, I lead the architecture, the delivery, and the teams behind them."
  />

  <section class="section">
    <div class="container">
      <ol class="timeline">
        {
          experience.map((role) => (
            <li class="timeline__item reveal">
              <div class="timeline__meta">
                <span class="timeline__dates">
                  <Icon name="calendar" size={16} />
                  {role.start} – {role.end}
                </span>
                <span class="timeline__loc">
                  <Icon name="map-pin" size={16} />
                  {role.location}
                </span>
              </div>

              <article class="card timeline__card">
                <header class="timeline__head">
                  <div>
                    <h2>{role.title}</h2>
                    <p class="timeline__org">
                      {role.orgUrl ? (
                        <a href={role.orgUrl} target="_blank" rel="noopener">
                          {role.org} <Icon name="arrow-up-right" size={14} />
                          <span class="visually-hidden">(opens in a new tab)</span>
                        </a>
                      ) : (
                        role.org
                      )}
                    </p>
                  </div>
                  {role.end === 'Present' && <span class="current">Current</span>}
                </header>
                <p class="timeline__summary">{role.summary}</p>
                <ul class="check-list">
                  {role.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <div class="timeline__foot">
                  <ul class="tag-list">
                    {role.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                  {caseStudies[role.org] && (
                    <a class="timeline__case" href={url(caseStudies[role.org])}>
                      Case study <Icon name="arrow-right" size={16} />
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: 14px;
    padding-left: 32px;
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: -40px;
    width: 2px;
    background: var(--line);
  }

  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__item::after {
    content: '';
    position: absolute;
    left: 2px;
    top: 5px;
    width: 12px;
    height: 12px;
    background: var(--turquoise);
    transform: rotate(45deg);
    border-radius: 2px;
    box-shadow: 0 0 0 5px var(--bg);
  }

  @media (min-width: 900px) {
    .timeline__item {
      grid-template-columns: 200px 1fr;
      gap: 40px;
      padding-left: 0;
    }
    .timeline__item::before {
      left: 223px;
    }
    .timeline__item::after {
      left: 218px;
    }
    .timeline__card {
      margin-left: 20px;
    }
  }

  .timeline__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-content: start;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .timeline__meta {
      flex-direction: column;
      text-align: right;
      align-items: flex-end;
    }
  }

  .timeline__dates,
  .timeline__loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .timeline__dates {
    color: var(--turquoise-strong);
    font-weight: 700;
  }

  .timeline__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .timeline__head h2 {
    margin-bottom: 4px;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
  }

  .timeline__org {
    margin: 0;
    font-weight: 600;
  }

  .timeline__org a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .current {
    flex: none;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--saffron-tint);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .timeline__summary {
    margin: 16px 0 20px;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .timeline__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .timeline__case {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
  }
</style>
