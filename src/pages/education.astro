---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { education } from '../data/site';
---

<Base
  title="Education"
  description="Sām Kazemi's education: B.S. in Computer Science with a minor in Persian Studies from San Francisco State University, and Los Medanos College."
>
  <PageHeader
    eyebrow="Education"
    title="Community college to computer science degree"
    lead="I started at Los Medanos College, transferred to San Francisco State, and graduated with a degree in Computer Science and a minor in Persian Studies: one for my career, one for my community."
  />

  <section class="section">
    <div class="container edu">
      {
        education.map((e, i) => (
          <article class="card edu__card reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="edu__icon">
              <Icon name="graduation-cap" size={26} />
            </div>
            <div class="edu__body">
              <div class="edu__head">
                <div>
                  <h2>{e.school}</h2>
                  <p class="edu__degree">{e.degree}</p>
                  <p class="edu__minor">{e.minor}</p>
                </div>
                <div class="edu__meta">
                  <span>
                    <Icon name="calendar" size={16} /> {e.start} – {e.end}
                  </span>
                  <span>
                    <Icon name="map-pin" size={16} /> {e.location}
                  </span>
                </div>
              </div>
              <ul class="edu__highlights">
                {e.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container edu-why">
      <div class="reveal">
        <p class="eyebrow">Why Persian Studies</p>
        <h2>A minor that is really a mission</h2>
      </div>
      <div class="reveal" style="--delay: 0.08s">
        <p class="lead">
          Computer science gave me a career. Persian Studies gave me the history, language, and
          literature of my people, and a clearer sense of what I want to give back.
        </p>
        <p class="muted">
          My goal is to become an Iranocentric scholar, educator, and community leader: someone who
          helps Iranians in the diaspora connect with their heritage, and who advocates for them.
          Alongside my coursework, I mentor fellow students through the MESA Program at San Francisco
          State, because a mentor is often what turns a possibility into a plan.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .edu {
    display: grid;
    gap: 24px;
  }

  .edu__card {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .edu__card {
      grid-template-columns: auto 1fr;
      gap: 28px;
    }
  }

  .edu__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: var(--saffron-tint);
    color: var(--ink);
  }

  .edu__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .edu__head h2 {
    margin-bottom: 6px;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
  }

  .edu__degree {
    margin: 0;
    font-weight: 600;
    color: var(--turquoise-strong);
  }

  .edu__minor {
    margin: 0;
    color: var(--ink-soft);
  }

  .edu__meta {
    display: grid;
    gap: 6px;
    align-content: start;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .edu__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .edu__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .edu__highlights li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--turquoise-tint);
    color: var(--turquoise-strong);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .edu-why {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .edu-why {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 64px;
    }
  }
</style>
