---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const topics = [
  {
    category: 'Engineering',
    icon: 'code',
    text: 'Lessons from building HIPAA-compliant software, multi-portal architecture, and shipping safely in regulated industries.',
  },
  {
    category: 'Community',
    icon: 'users',
    text: 'Iranian history, language, and culture, and what it takes to build strong communities in the diaspora.',
  },
  {
    category: 'Growth',
    icon: 'trending-up',
    text: 'The path from Antioch and community college to leading engineering teams: discipline, mentorship, and mindset.',
  },
] as const;

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Writing"
  description="Writing by Sām Kazemi on engineering, the Iranian community, and personal growth."
>
  <PageHeader
    eyebrow="Writing"
    title="Notes on code, community, and growth"
    lead="Essays and field notes on building software that serves people, on Iranian heritage, and on the long road from where I started."
  />

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <ul class="posts">
            {posts.map((post) => (
              <li class="reveal">
                <a class="post card card--hover" href={url(`/blog/${post.id}`)}>
                  <span class="post__meta">
                    <span class="tag">{post.data.category}</span>
                    <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                  </span>
                  <h2>{post.data.title}</h2>
                  <p class="muted">{post.data.description}</p>
                  <span class="post__more">
                    Read post <Icon name="arrow-right" size={16} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty card reveal">
            <span class="icon-badge">
              <Icon name="pen-line" />
            </span>
            <h2>First posts are on the way</h2>
            <p class="muted">
              I’m writing the first pieces now. In the meantime, here is what you can expect.
            </p>
          </div>
        )
      }

      <div class="section-head topics-head reveal">
        <p class="eyebrow">What I write about</p>
        <h2>Three themes</h2>
      </div>
      <div class="grid grid--3">
        {
          topics.map((t, i) => (
            <div class="card reveal" style={`--delay: ${i * 0.08}s`}>
              <span class="icon-badge">
                <Icon name={t.icon} />
              </span>
              <h3 class="topic__title">{t.category}</h3>
              <p class="muted">{t.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .posts {
    display: grid;
    gap: 20px;
    margin: 0 0 clamp(56px, 8vw, 88px);
    padding: 0;
    list-style: none;
  }

  .post {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post:hover {
    color: inherit;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .post h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
  }

  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--turquoise-strong);
  }

  .empty {
    max-width: 640px;
    margin: 0 auto clamp(56px, 8vw, 88px);
    text-align: center;
    border-style: dashed;
  }

  .empty .icon-badge {
    margin: 0 auto 16px;
  }

  .empty h2 {
    font-size: 1.5rem;
  }

  .empty p {
    margin: 0;
  }

  .topics-head {
    margin-bottom: 32px;
  }

  .topic__title {
    margin-top: 18px;
  }
</style>
