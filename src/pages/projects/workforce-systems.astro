---
import Screenshot from '../../components/Screenshot.astro';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';
import unionDashboard from '../../assets/projects/wfs/union-dashboard.png';
import unionHall from '../../assets/projects/wfs/union-hall.png';
import contractorRequest from '../../assets/projects/wfs/contractor-request.png';
import contractorCompliance from '../../assets/projects/wfs/contractor-compliance.png';
import memberPortal from '../../assets/projects/wfs/member-portal.png';
import memberPortalWallet from '../../assets/projects/wfs/member-portal-wallet.png';
import healthConnect from '../../assets/projects/wfs/health-connect.png';
import healthCoverage from '../../assets/projects/wfs/health-coverage.png';
import memberHome from '../../assets/projects/wfs/member-home.png';
import memberTicket from '../../assets/projects/wfs/member-ticket.png';
import memberWallet from '../../assets/projects/wfs/member-wallet.png';
import appMap from '../../assets/projects/wfs/app-map.png';
import appTraining from '../../assets/projects/wfs/app-training.png';
import appCourse from '../../assets/projects/wfs/app-course.png';
import appReport from '../../assets/projects/wfs/app-report.png';
import unionClass from '../../assets/projects/wfs/union-class.png';
import unionImport from '../../assets/projects/wfs/union-import.png';

const desktopSizes = '(min-width: 1000px) 960px, calc(100vw - 32px)';
const pairSizes = '(min-width: 1000px) 470px, (min-width: 900px) 45vw, calc(100vw - 32px)';
const phoneSizes = '(min-width: 760px) 230px, (min-width: 600px) 30vw, 64vw';

const phoneScreens = [
  { src: memberHome, alt: 'Member app home screen on the morning of a dispatch, with a clock-in button and the week’s hours' },
  { src: memberTicket, alt: 'Member app dispatch ticket showing the jobsite, gate, shift, foreman, and pay' },
  { src: memberWallet, alt: 'Member app wallet with the member’s union card and a warning that a certification lapses soon' },
];

const trainingScreens = [
  { src: appTraining, alt: 'Member app training screen: the lapsing HAZWOPER card with a renewal seat to reserve, above the online courses' },
  { src: appCourse, alt: 'An online course in the member app: the current lesson over a video still, lessons watched, run time, and the quiz’s pass mark' },
  { src: appReport, alt: 'An apprentice’s July hours report in the member app: totals by work process, today’s entries, and buttons to save a draft or post the report' },
];

const appRules = [
  'Sign-in runs against the same Laravel API as the web portals, and the token is kept in the iOS Keychain or Android Keystore. A release build ignores any start screen it is handed, so nothing can open a screen behind sign-in.',
  'Every screen reads its data through one typed loader, and the whole app runs on the scenario’s clock rather than the phone’s, so every date, countdown, and “in 7 days” agrees with the web portal.',
  'Every control has a screen-reader label, text grows with the phone’s setting up to 130%, the most its fixed-width rows can hold, and the fonts ship inside the app, so no request leaves it to fetch them.',
  'A route test opens all 46 screens at three sizes, including a small phone with enlarged text, and CI checks formatting, static analysis, and the tests on every push.',
];

const staffRules = [
  'Imports read a CSV in the browser and check every field before anything is written: member-number and date formats, amounts above zero, five-digit ZIP codes, and duplicates. Rows with errors are left out, never half-loaded.',
  'Batch posting from lockbox, payroll-deduction, and ACH-return files matches a payment only when the member is on the roll and the amount is a whole number of months at the dues rate.',
  'Converting old records to the Department of Labor’s separate race and ethnicity fields carries over only what a value actually states. When a value spans two answers or none, the screen asks the member instead of guessing.',
  'A new dues or pay rate can only take effect after today, bargaining-unit codes must be unique, and a closed register day, an issued transfer, or a confirmed benefit election can’t be edited.',
];

const surfaces = [
  { name: 'Union operations · 35 screens', text: 'The desktop workspace for business agents, dispatchers, and officers: dispatch, membership, dues, grievances, training, and reporting. It is the system of record behind everything else.' },
  { name: 'Contractor portal · 15 screens', text: 'For coordinators, payroll clerks, and foremen. Contractors will click a link but won’t install an app, so it lives on the web, and it is responsive because the foreman is on a jobsite with a phone.' },
  { name: 'Member portal · 41 screens', text: 'Everything a member can do on a desktop: dispatch, dues, pension, credentials, training, apprenticeship hours, and health coverage, with no separate login for health.' },
  { name: 'Member app · 46 screens', text: 'A laborer has no desk, so the phone is where most members will live. The app is built in Flutter as its own project, on the same API, with five tabs: Home, Dispatch, Wallet, Hall, and Me.' },
  { name: 'Sign-in and the public website', text: 'Members, union staff, and contractors each sign in from the union’s public website, which has its own case study.' },
];

const spine = [
  { name: 'Request workers', text: 'A contractor asks the hall for workers from the contractor portal, naming the classification, the certifications the work needs, and the start.' },
  { name: 'Work the request', text: 'Dispatchers work it at the dispatch window and turn it into a call.' },
  { name: 'Dispatch', text: 'The member gets a dispatch ticket and joins the contractor’s crew roster.' },
  { name: 'Clock in', text: 'Clock-ins from the member’s phone feed the contractor’s certified payroll.' },
  { name: 'Post the hours', text: 'Certified hours post to the union’s ledger and to the member’s own assignment history.' },
  { name: 'Back on the books', text: 'When the job releases, the member signs back onto the out-of-work list, and the cycle starts again.' },
];

const coverageRules = [
  'No credential ever touches the platform. Members authorize on the carrier’s own site through OAuth, and there is no carrier sign-in form anywhere, not even a mock one, because a page that looks like a carrier sign-in is a phishing page regardless of intent.',
  'Carrier fields are normalized into one standard model, and the mapping is shown. The coverage record names both the standard field and the carrier field it came from, so no other screen has to know which carrier it is reading.',
  'The union’s own benefit trust is one source among many. Its eligibility still comes from the member’s hour bank, so revoking a carrier connection never touches it.',
];
---

<CaseStudy
  name="Union Workforce Ecosystem"
  description="Case study: the Union Workforce Ecosystem, a workforce platform for a laborers’ union that Sām Kazemi leads as Lead Developer at Workforce Systems, built in Next.js and TypeScript with a Flutter member app, on a Laravel API."
  summary="A workforce platform for a laborers’ union: one Next.js app for union staff, contractors, and members, and a Flutter app for members’ phones, both on a Laravel API, unifying dispatch, dues, grievances, training, and benefits into one system of record."
  role="Lead Developer: platform design, web and mobile front end"
  org="Workforce Systems (WFS)"
  period="Jul 2026 – Present"
  status="In development under contract"
  live="https://workforcesystems.net/"
  liveLabel="workforcesystems.net"
  accent="lapis"
  stack={[
    'Next.js (App Router)',
    'React',
    'TypeScript',
    'Tailwind CSS',
    'Flutter',
    'Dart',
    'Laravel REST API',
    'Sanctum token auth',
    'MySQL',
    'Playwright',
    'GitHub Actions CI',
    'AWS Amplify',
    'OAuth 2.0',
    'Design systems',
  ]}
>
  <section class="reveal">
    <p class="eyebrow">The challenge</p>
    <h2>Unions run on disconnected tools</h2>
    <p>
      A union keeps its members working through dispatch, collects dues, handles grievances, tracks
      training and certifications, and connects members to benefits. Those jobs usually live in
      separate systems, spreadsheets, and paper, so the same member’s information is scattered and
      often out of sync.
    </p>
    <p>
      Workforce Systems is a company that builds digital infrastructure platforms, primarily for
      unions. As its Lead Developer, Sām designs the platform, builds it, and works with union
      leadership to turn their day-to-day operations into a product, including helping secure the
      contracts that put it to work.
    </p>
    <p>
      The platform is being built under contract for a union and its members, contractors, and staff.
      It is not membership software with a portal bolted on. It is one system that follows a worker
      from recruitment through retirement.
    </p>
    <figure class="cs-shot">
      <Screenshot
        src={unionDashboard}
        alt="Union operations executive dashboard: membership counts, open dispatch calls, dues collected, grievances, and the items that need an officer"
        widths={[800, 1200, 1600, 2200]}
        sizes={desktopSizes}
        class="cs-screen"
      />
      <figcaption>
        Union operations on a Friday morning: who is working, which calls won’t fill, dues
        collected, and what needs an officer. Names and places in every screen are placeholders.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">What it covers</p>
    <h2>Four pillars</h2>
    <div class="cs-features">
      <div class="card">
        <span class="icon-badge"><Icon name="briefcase" /></span>
        <h3>Union operations</h3>
        <p>Membership, dues, dispatch, grievances, training, communications, and analytics.</p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="heart-pulse" /></span>
        <h3>Health and wellness</h3>
        <p>Insurance connection and verification, plus injury reporting and return to work.</p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="trending-up" /></span>
        <h3>Workforce intelligence</h3>
        <p>Labor-demand forecasting, certification tracking, and retirement projections.</p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="users" /></span>
        <h3>Member experience</h3>
        <p>Self-service on the web and on a phone, with benefits and digital credentials.</p>
      </div>
    </div>
  </section>

  <section class="reveal">
    <p class="eyebrow">The product</p>
    <h2>Three portals, a phone app, one system of record</h2>
    <p>
      The web platform is a single Next.js application written in strict TypeScript, and the member
      app is written in Flutter. Union operations holds the data, and every other surface is a view
      onto it: a contractor’s request for workers
      becomes a call at the hall, which becomes a dispatch on a member’s phone, with no re-keying in
      between. Each surface’s form follows from who uses it and where they are.
    </p>
    <ul class="cs-flow">
      {
        surfaces.map((s) => (
          <li>
            <div>
              <strong>{s.name}</strong>
              <span>{s.text}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <p>
      The public side is the{' '}
      <a href={url('/projects/labor-union-website')}>labor union website</a>, which lives in the
      same app and is where every account type signs in.
    </p>
    <figure class="cs-shot">
      <Screenshot
        src={memberPortal}
        alt="Member portal home on the morning of a dispatch: the jobsite, report time, and foreman, a clock-in button, the week’s hours, pension progress, and dues"
        widths={[800, 1200, 1600, 2200]}
        sizes={desktopSizes}
        class="cs-screen"
      />
      <figcaption>
        The member portal on the morning of a dispatch: the job, the week’s hours, pension progress,
        dues, and the certification that needs attention.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">The member app</p>
    <h2>The same record, in a laborer’s pocket</h2>
    <p>
      The member app was ported from the same prototype as the web portals, screen for screen, and
      covers what a member does from a jobsite: clocking in, the dispatch ticket at the gate, the
      card wallet, dues, the steward, health coverage, training, and apprenticeship hours. It shows
      the same member on the same morning as the member portal, down to the minutes before report
      time.
    </p>
    <figure class="cs-shot">
      <div class="cs-phones">
        {phoneScreens.map((s) => <Screenshot src={s.src} alt={s.alt} widths={[300, 500, 700]} sizes={phoneSizes} class="cs-screen cs-phone" />)}
      </div>
      <figcaption>
        The Flutter member app: home on the morning of a dispatch, the dispatch ticket, and the
        wallet holding the member’s union card.
      </figcaption>
    </figure>
    <ul class="check-list">
      {appRules.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <section class="reveal">
    <p class="eyebrow">The core workflow</p>
    <h2>From a contractor’s request to a member’s hours</h2>
    <p>
      Dispatch is the spine the whole platform hangs on, and it is the first workflow the backend
      takes on. Each step below is a screen in one portal that hands off to a screen in another.
    </p>
    <ul class="cs-flow">
      {
        spine.map((s) => (
          <li>
            <div>
              <strong>{s.name}</strong>
              <span>{s.text}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <figure class="cs-shot cs-shot--wide">
      <div class="cs-pair">
        <Screenshot
          src={contractorRequest}
          alt="Contractor portal new dispatch request: site, classification, number of workers, start date, required certifications, and what the hall will receive"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
        <Screenshot
          src={unionHall}
          alt="Union operations dispatch hall showing the out-of-work referral lists, with registered and signed counts for each list"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
      </div>
      <figcaption>
        Both ends of a call: the contractor’s request, which warns that a confined-space requirement
        will thin the list, and the hall’s out-of-work lists that fill it.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">Health and wellness</p>
    <h2>Coverage from any carrier</h2>
    <p>
      Health coverage is built on connected insurance, not a single assumed plan. A member either
      authorizes their carrier to share their coverage or, when a carrier can’t connect digitally,
      photographs their insurance card for the benefit trust office to verify by hand. Every source
      resolves to one of three states: connected, pending verification, or action required.
    </p>
    <figure class="cs-shot cs-shot--wide">
      <div class="cs-pair">
        <Screenshot
          src={healthConnect}
          alt="Authorizing a read-only carrier connection, listing exactly what is requested and what is not, with the terms of the authorization"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
        <Screenshot
          src={healthCoverage}
          alt="Coverage record pending verification, with each value labeled by the carrier field it came from and a connection log"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
      </div>
      <figcaption>
        Authorizing a read-only connection on the carrier’s own site, then a coverage record that
        names the carrier field behind every value.
      </figcaption>
    </figure>
    <ul class="check-list">
      {coverageRules.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <section class="reveal">
    <p class="eyebrow">One scenario</p>
    <h2>The same story from both sides</h2>
    <p>
      Every screen shows the same member on the same morning, and the screens cross-reference
      constantly. A laborer is dispatched to a waterfront job, but a hazardous-waste safety
      certification lapses the day after that job releases, which blocks them from the one open call
      they could take next. The member’s wallet shows the problem. The contractor portal shows the
      same card as the contractor’s only compliance exception, and explains why the call they placed
      won’t fill.
    </p>
    <figure class="cs-shot cs-shot--wide">
      <div class="cs-pair">
        <Screenshot
          src={contractorCompliance}
          alt="Contractor portal compliance matrix with one laborer’s HAZWOPER 40 certification flagged as lapsing"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
        <Screenshot
          src={memberPortalWallet}
          alt="Member portal credential wallet warning that the same HAZWOPER 40 card lapses in 22 days, with a renewal session to reserve"
          widths={[600, 900, 1400]}
          sizes={pairSizes}
          class="cs-screen"
        />
      </div>
      <figcaption>
        One lapsing certification: the exception in the contractor’s compliance matrix, and the
        warning in the member’s wallet with a renewal seat to reserve.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">Training and apprenticeship</p>
    <h2>From an online course to a graded class</h2>
    <p>
      Training runs through every side of the platform. Members take short online courses, from heat
      illness and silica to knowing their contract, on the web or in the app. Each one is a set of
      video lessons and a four-question quiz that passes at three of four, and the quiz can’t be
      submitted until every question is answered.
    </p>
    <p>
      Apprentices log their on-the-job hours each month, day by day and by work process. Posted
      months must add up to the hours on the training center’s roster, a month before indenture or
      in the future can’t be started, and posting locks the report until the training coordinator
      signs it off. A card shows how far the apprentice is from the next 1,000-hour step, and the
      classroom hours still owed before it.
    </p>
    <figure class="cs-shot">
      <div class="cs-phones">
        {trainingScreens.map((s) => <Screenshot src={s.src} alt={s.alt} widths={[300, 500, 700]} sizes={phoneSizes} class="cs-screen cs-phone" />)}
      </div>
      <figcaption>
        In the member app: training, with the lapsing card and the online courses, a course’s
        lessons, and an apprentice’s July hours report.
      </figcaption>
    </figure>
    <p>
      On the union side, each training-center class has a roster, attendance, scored components,
      and a waiting list. Before anyone is seated, enrollment checks the class type, the member’s
      standing, dues paid through last month, prerequisite cards, and the enrollment window, and
      seats never exceed the class maximum. Grading follows written rules: a withdrawal is a W,
      missing every day is a no-show, a single missed day needs a make-up, and otherwise the
      weighted component score passes at 75%.
    </p>
    <figure class="cs-shot">
      <Screenshot
        src={unionClass}
        alt="A training-center class waiting to be graded: enrollment, seats left, attendance, and a roster where each row’s hours and score say pass, fail, or no show"
        widths={[800, 1200, 1600, 2200]}
        sizes={desktopSizes}
        class="cs-screen"
      />
      <figcaption>
        A class waiting to be graded: each row says what its attendance and weighted score add up
        to, and an administrator confirms the grade.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">Staff tools</p>
    <h2>Retiring a legacy desktop system</h2>
    <p>
      The union’s staff kept their records in an older desktop system, so the union portal rebuilds
      the tools they relied on there: bargaining units, dues and pay rates, imports, batch posting, a
      cash register per office, custom fields on the member record, and a custom report builder.
      Each one stops a bad record at the door.
    </p>
    <ul class="check-list">
      {staffRules.map((r) => <li>{r}</li>)}
    </ul>
    <figure class="cs-shot">
      <Screenshot
        src={unionImport}
        alt="The union portal’s import: a CSV’s columns mapped to member fields, a preview with rows flagged in error, and past imports with how many rows each rejected"
        widths={[800, 1200, 1600, 2200]}
        sizes={desktopSizes}
        class="cs-screen"
      />
      <figcaption>
        An import that won’t half-load: rows that fail a check are left out, and every past run
        records what it rejected.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">Engineering highlights</p>
    <h2>Built to swap fixtures for real data</h2>
    <div class="cs-features">
      <div class="card">
        <span class="icon-badge"><Icon name="layers" /></span>
        <h3>Prototype first, then product</h3>
        <p>
          The platform started as an 85-screen static prototype. Every desktop screen was then
          ported into the Next.js app with the same Tailwind tokens, and every phone screen into
          the Flutter app with the same colors and type, so the product matches the prototype
          screen for screen.
        </p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="compass" /></span>
        <h3>One door to data</h3>
        <p>
          Screens never read data directly. Each one awaits a typed function in a single data-access
          layer, and a lint rule fails any screen that imports the sample data itself. When an
          endpoint lands, one function body changes and no screen does.
        </p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="lock" /></span>
        <h3>Sign-in that fails closed</h3>
        <p>
          Members, union staff, and contractors are separate account types on the API. Tokens live
          in httpOnly cookies the browser never reads, every portal re-checks its token with the API,
          and sign-out refuses a request from another site.
        </p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="shield" /></span>
        <h3>A backend that refuses the wrong token</h3>
        <p>
          On the team’s Laravel API, Sām added contractor accounts with middleware that rejects
          member and admin tokens, fixed a password-reset email that linked to a page that didn’t
          exist, and covered both with feature tests.
        </p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="check-circle" /></span>
        <h3>Every screen tested</h3>
        <p>
          Playwright opens every route and fails on any console error, then runs the key flows:
          signing in as each account type, resetting a password, paying dues, clocking in, payroll,
          exports, and filing a grievance. CI runs type checks, lint, the build, and the tests on
          every push.
        </p>
      </div>
      <div class="card">
        <span class="icon-badge"><Icon name="file-text" /></span>
        <h3>Two design systems, one stylesheet</h3>
        <p>
          The portals and the public website each have their own visual system, scoped so they can’t
          bleed into each other. Fonts are self-hosted rather than loaded from Google, which matters
          for a platform that handles health data.
        </p>
      </div>
    </div>
    <p>
      Two rules from the prototype carried into the product. Totals, counts, and rates are computed
      from the rows they summarize, so a roster and the dashboard that sums it can’t disagree. And
      the prototype’s interactive application map, which derives every screen, route, and data flow
      from three tables, remains the map of what connects to what.
    </p>
    <figure class="cs-shot">
      <Screenshot
        src={appMap}
        alt="Application map blueprint connecting the public website, sign-in, the portals, and outside parties, with the planned production platform below"
        widths={[800, 1200, 1600, 2200]}
        sizes={desktopSizes}
        class="cs-screen"
      />
      <figcaption>
        The prototype’s application map: every portal, route, and data flow, derived from the same
        tables.
      </figcaption>
    </figure>
  </section>

  <section class="reveal">
    <p class="eyebrow">Why it matters</p>
    <h2>Building for working people</h2>
    <p>
      Laborers deserve software as good as anything in their pockets. When dispatch, dues, and
      benefits live in one place, members spend less time chasing paperwork and more time working,
      and the union can see its whole workforce at a glance. This is early-stage work at a startup,
      and it is the kind of work he wants to keep doing: technology in service of people who are
      often overlooked by it.
    </p>
  </section>
</CaseStudy>
