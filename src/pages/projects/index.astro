---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import clearpathPreview from '../../assets/photos/clearpath-preview.png';
import wfsPreview from '../../assets/photos/wfs-preview.png';

const projects = [
  {
    name: 'ClearPath Virtual Health',
    org: 'MedManage Solutions',
    role: 'Lead Software Engineer',
    period: 'Sep 2025 – Present',
    href: '/projects/clearpath',
    live: 'https://clearpathvirtualhealth.com/',
    liveLabel: 'clearpathvirtualhealth.com',
    image: clearpathPreview,
    imageAlt: 'ClearPath Virtual Health patient view: care coordinator, blood pressure trend, care-plan goal, and upcoming virtual visit',
    text: 'A production HIPAA-compliant CCM/RPM platform, architected from the ground up. Four role-based portals, MFA and audit logging, Medicare billing workflows, and AWS infrastructure behind it.',
    tags: ['React', 'AWS', 'HIPAA', 'RBAC', 'CI/CD', 'CPT / ICD-10'],
  },
  {
    name: 'Union Workforce Ecosystem',
    org: 'Workforce Systems (WFS)',
    role: 'Lead Developer',
    period: 'Jul 2026 – Present',
    href: '/projects/workforce-systems',
    live: 'https://workforcesystems.net/',
    liveLabel: 'workforcesystems.net',
    image: wfsPreview,
    imageAlt: 'Union Workforce Ecosystem operations dashboard beside the member app clock-in screen',
    text: 'A five-portal workforce platform built for a union, unifying dispatch, dues, grievances, training, and benefits into one system of record, with a carrier-agnostic health coverage model and a shared design system.',
    tags: ['Platform design', 'Design system', 'Node.js tooling', 'Mobile UI'],
  },
] as const;
---

<Base
  title="Projects"
  description="Featured projects by Sām Kazemi: ClearPath Virtual Health and the Union Workforce Ecosystem, a labor platform built at Workforce Systems."
>
  <PageHeader
    eyebrow="Projects"
    title="Platforms built for patients and workers"
    lead="Case studies from the two platforms Sām leads today: what the problem was, what he built, and what changed because of it."
  />

  <section class="section">
    <div class="container projects">
      {
        projects.map((p) => (
          <article class="project reveal">
            <div class="project__visual">
              <Image
                src={p.image}
                alt={p.imageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 900px) 640px, calc(100vw - 32px)"
                class="project__img"
              />
            </div>

            <div class="project__body">
              <p class="project__meta">
                {p.role} · {p.org} · {p.period}
              </p>
              <h2>{p.name}</h2>
              <p class="project__text">{p.text}</p>
              <ul class="tag-list">
                {p.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <div class="btn-row project__actions">
                <a class="btn btn--primary" href={url(p.href)}>
                  Read case study <Icon name="arrow-right" />
                </a>
                <a class="btn btn--ghost" href={p.live} target="_blank" rel="noopener">
                  {p.liveLabel} <Icon name="arrow-up-right" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }

      <p class="projects__more reveal">
        More of his code lives on{' '}
        <a href="https://github.com/sammokazemi" target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" size={14} /></a>.
      </p>
    </div>
  </section>

</Base>

<style>
  .projects {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
  }

  .project {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: 0.85fr 1.15fr;
    }
    /* Mirror the columns so the text keeps the wider one and both cards stay the same height. */
    .project:nth-child(even) {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .project:nth-child(even) .project__visual {
      order: 2;
    }
  }

  .project__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    background: linear-gradient(180deg, #eef7f5, #dcece9);
  }

  .project:nth-child(even) .project__visual {
    padding: 16px;
    background: linear-gradient(180deg, #ffffff, #e6eefa);
  }

  .project__visual :global(.project__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project__body {
    padding: clamp(24px, 4vw, 44px);
  }

  .project__meta {
    margin-bottom: 8px;
    color: var(--gold-strong);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project__text {
    color: var(--ink-soft);
    margin-bottom: 20px;
  }

  .project__actions {
    margin-top: 28px;
  }

  .projects__more {
    margin: 0;
    text-align: center;
    color: var(--muted);
  }

  .projects__more a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }
</style>
