---
import { site } from '../data/site';
---

<span class="logo">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <g transform="translate(20 20)">
      <rect x="-10" y="-10" width="20" height="20" rx="2" class="logo__a" />
      <rect x="-10" y="-10" width="20" height="20" rx="2" class="logo__a" transform="rotate(45)" />
      <rect x="-4.5" y="-4.5" width="9" height="9" rx="1" class="logo__b" transform="rotate(45)" />
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__fa persian" lang="fa">{site.persianName}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo__mark {
    width: 36px;
    height: 36px;
    flex: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  a:hover .logo__mark {
    transform: rotate(45deg);
  }

  .logo__a {
    fill: var(--turquoise);
  }

  .logo__b {
    fill: var(--saffron);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .logo__fa {
    font-size: 0.72rem;
    color: var(--muted);
    text-align: left;
    line-height: 1.9;
  }
</style>
