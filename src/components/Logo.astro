---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logoLight from '../assets/logo/logo-light.png';
import logoDark from '../assets/logo/logo-dark.png';
---

<span class="logo">
  <span class="logo__mark" aria-hidden="true">
    <Image src={logoLight} alt="" widths={[40, 80, 120]} sizes="40px" class="logo__img logo__img--light" />
    <Image src={logoDark} alt="" widths={[40, 80, 120]} sizes="40px" class="logo__img logo__img--dark" />
  </span>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__op old-persian" lang="peo">{site.oldPersianName}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo__mark {
    position: relative;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  a:hover .logo__mark {
    transform: scale(1.06);
  }

  .logo__mark :global(.logo__img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* One image per theme; the other stays hidden. */
  .logo__mark :global(.logo__img--dark) {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo__mark :global(.logo__img--light) {
    display: none;
  }
  :global(:root[data-theme='dark']) .logo__mark :global(.logo__img--dark) {
    display: block;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .logo__op {
    margin-top: 3px;
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
