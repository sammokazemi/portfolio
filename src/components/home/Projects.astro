---
import Icon from '../Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../../lib/url';
import clearpathPreview from '../../assets/photos/clearpath-preview.png';
import darkCirclesPreview from '../../assets/photos/dark-circles-preview.png';
import planetPooyahPreview from '../../assets/photos/planet-pooyah-preview.png';

type Project = {
  name: string;
  org: string;
  role: string;
  period: string;
  href: string;
  /** Omitted when the project has no public URL that can be shared. */
  live?: string;
  liveLabel?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Backdrop behind the preview image. */
  tone: 'turquoise' | 'lapis';
  text: string;
  tags: string[];
};

// Newest first, by start date.
const projects: Project[] = [
  {
    name: 'Planet Pooyah',
    org: 'Planet Pooyah',
    role: 'Founder',
    period: 'Oct 2026 – Present',
    href: '/projects/planet-pooyah',
    live: 'https://planetpooyah.com/',
    liveLabel: 'planetpooyah.com',
    image: planetPooyahPreview,
    imageAlt: 'The Planet Pooyah home page on a desktop beside a lesson on a phone teaching the Haft-Seen table, with the Persian word in large letters',
    tone: 'lapis',
    text: 'A game-like app that helps children of the Iranian diaspora read and write Persian and know the stories, history, and traditions behind it. One Next.js codebase for the web, Android, and iOS, on a Laravel API with Stripe subscriptions.',
    tags: ['Next.js', 'TypeScript', 'Capacitor', 'Laravel API', 'Stripe'],
  },
  {
    name: 'Dark Circles',
    org: 'Violent Delights Productions',
    role: 'Website Developer',
    period: 'Oct 2026 – Present',
    href: '/projects/dark-circles',
    image: darkCirclesPreview,
    imageAlt: 'The Dark Circles cover page on a desktop beside the same page on a phone, where a dark circle under a finger reveals a word in Farsi',
    tone: 'turquoise',
    text: 'The website for a 30-episode vertical dark comedy, designed as its lead’s flawless medical-school application, with her unfiltered inner voice scrawled in the margins and a dark circle that cuts through the paper to show it.',
    tags: ['Astro', 'TypeScript', 'Modern CSS', 'Design system'],
  },
  {
    name: 'ClearPath Virtual Health',
    org: 'MedManage Solutions',
    role: 'Lead Software Engineer',
    period: 'Sep 2025 – Oct 2026',
    href: '/projects/clearpath',
    live: 'https://clearpathvirtualhealth.com/',
    liveLabel: 'clearpathvirtualhealth.com',
    image: clearpathPreview,
    imageAlt: 'The ClearPath Virtual Health website’s home page beside the home screen of the ClearPath patient app on a phone',
    tone: 'turquoise',
    text: 'A production HIPAA-compliant CCM/RPM platform, architected from the ground up. Four role-based portals, MFA and audit logging, Medicare billing workflows, and AWS infrastructure behind it.',
    tags: ['React', 'AWS', 'HIPAA', 'RBAC', 'CI/CD', 'CPT / ICD-10'],
  },
];
---

<section class="section" id="projects">
  <div class="container">
    <div class="section-head projects-head reveal">
      <p class="eyebrow">Projects</p>
      <h2>Shipped work in health, education, and media</h2>
      <p class="lead">
        Case studies from the work Sām has led: what the problem was, what he built, and what
        changed because of it.
      </p>
    </div>
    <div class="projects">
      {
        projects.map((p) => (
          <article class="project reveal">
            <div class={`project__visual project__visual--${p.tone}`}>
              <Image
                src={p.image}
                alt={p.imageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 900px) 440px, calc(100vw - 32px)"
                class="project__img"
              />
            </div>

            <div class="project__body">
              <p class="project__meta">
                {p.role} · {p.org} · {p.period}
              </p>
              <h3>{p.name}</h3>
              <p class="project__text">{p.text}</p>
              <ul class="tag-list">
                {p.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <div class="btn-row project__actions">
                <a class="btn btn--primary" href={url(p.href)}>
                  Read case study <Icon name="arrow-right" />
                </a>
                {p.live && (
                  <a class="btn btn--ghost" href={p.live} target="_blank" rel="noopener">
                    {p.liveLabel} <Icon name="arrow-up-right" />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }

      <p class="projects__more reveal">
        More of his code lives on{' '}
        <a href="https://github.com/sammokazemi" target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" size={14} /></a>.
      </p>
    </div>
  </div>
</section>

<style>
  /* The heading runs the full width on one line; the lead keeps the usual 680px measure. */
  .projects-head {
    max-width: none;
  }

  .projects-head .lead {
    max-width: 680px;
  }

  .projects {
    display: grid;
    gap: 20px;
  }

  .project {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: 0.7fr 1.3fr;
    }
    /* Mirror the columns so the text keeps the wider one and both cards stay the same height. */
    .project:nth-child(even) {
      grid-template-columns: 1.3fr 0.7fr;
    }
    .project:nth-child(even) .project__visual {
      order: 2;
    }
  }

  .project__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .project__visual--turquoise {
    background: linear-gradient(180deg, #eef7f5, #dcece9);
  }

  .project__visual--lapis {
    padding: 12px;
    background: linear-gradient(180deg, #ffffff, #e6eefa);
  }

  .project__visual :global(.project__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project__body {
    padding: clamp(20px, 3vw, 28px);
  }

  .project__body h3 {
    margin-bottom: 6px;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .project__meta {
    margin-bottom: 4px;
    color: var(--gold-strong);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project__text {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-bottom: 14px;
  }

  .project__actions {
    margin-top: 18px;
  }

  .project__actions .btn {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.9rem;
  }

  .projects__more {
    margin: 0;
    text-align: center;
    color: var(--muted);
  }

  .projects__more a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }
</style>
