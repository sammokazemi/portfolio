---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav } from '../data/site';
import { url, isActive } from '../lib/url';

const path = Astro.url.pathname;
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <!-- #hero: on the home page this scrolls up to the hero instead of reloading. -->
    <a href={url('/#hero')} class="nav__brand" aria-label="Sām Kazemi, home">
      <Logo />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(path, url(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <a href={url('/about')} class="btn btn--primary nav__cta">About Sām</a>
      <button
        class="nav__icon-btn nav__settings"
        type="button"
        aria-expanded="false"
        aria-controls="settings-panel"
        aria-label="Settings"
        data-settings-toggle
      >
        <Icon name="settings" />
      </button>
      <button
        class="nav__icon-btn nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<!-- Outside the header on purpose: the header's backdrop-filter would make it the
     menu's containing block, and the off-screen menu would then widen the page on phones. -->
<nav class="nav__mobile" id="mobile-menu" aria-label="Mobile">
  <ul>
    {
      nav.map((item) => (
        <li>
          <a href={url(item.href)} aria-current={isActive(path, url(item.href)) ? 'page' : undefined}>
            {item.label}
            <Icon name="arrow-right" size={18} />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  // The menu slides in from the right like the settings panel (Settings.astro).
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.visually-hidden')!.textContent = open ? 'Close menu' : 'Open menu';
    menu.toggleAttribute('data-open', open);
    header.classList.toggle('is-open', open);
    if (open) {
      // Only one panel at a time: close settings if it's open.
      const settings = document.querySelector<HTMLButtonElement>('[data-settings-toggle]');
      if (settings?.getAttribute('aria-expanded') === 'true') settings.click();
      menu.querySelector('a')?.focus();
    } else if (returnFocus) {
      toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(!isOpen()));
  // Most links jump to a section of this same page, so close the menu on any link click.
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) setMenu(false, !!menu?.contains(document.activeElement));
  });
  // A click anywhere outside the menu closes it (the toggle handles its own clicks).
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    if (isOpen() && !menu?.contains(target) && !toggle?.contains(target)) setMenu(false);
  });
  // So does tabbing out of it, so keyboard focus never lands on a link hidden under it.
  menu?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (next && !menu.contains(next) && !toggle?.contains(next)) setMenu(false);
  });
  window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
  // Back/forward navigation can restore this page exactly as it was left, with the
  // menu open after a menu link was followed. Start closed.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) setMenu(false);
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Scroll-spy: on the home page, the link for the section under the navbar gets
  // aria-current="location" and turns gold. Nothing is current above the first section.
  const path = (p: string) => p.replace(/\/$/, '');
  const spy = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a, .nav__mobile a')].flatMap((a) => {
    const target = new URL(a.href);
    const section = path(target.pathname) === path(location.pathname) && target.hash ? document.getElementById(target.hash.slice(1)) : null;
    return section ? [{ a, section }] : [];
  });
  if (spy.length) {
    const updateSpy = () => {
      const line = (header?.offsetHeight ?? 72) + 8;
      let current: HTMLElement | null = null;
      for (const { section } of spy) if (section.getBoundingClientRect().top <= line) current = section;
      // The last section can be too short to reach the navbar; at the bottom, it is the current one.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = spy.at(-1)!.section;
      for (const { a, section } of spy) {
        if (section === current) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    // Cheap enough (a handful of rects) to run on every scroll event without throttling.
    updateSpy();
    window.addEventListener('scroll', updateSpy, { passive: true });
    window.addEventListener('resize', updateSpy, { passive: true });
  }

  // The settings button is handled by Settings.astro.
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .nav.is-scrolled,
  .nav.is-open {
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-sm);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }

  .nav__brand {
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .nav__links {
    display: none;
  }

  .nav__links ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__links a {
    position: relative;
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--ink-soft);
    font-size: 0.925rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }

  .nav__links a:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }

  /* Light mode: a fainter hover highlight than the default. */
  :global(:root:not([data-theme='dark'])) .nav__links a:hover {
    background: color-mix(in srgb, var(--bg-alt) 45%, transparent);
  }

  .nav__links a[aria-current='page'] {
    color: var(--gold-strong);
    font-weight: 600;
  }

  /* The section in view (scroll-spy). Color only, so the links don't shift as it moves. */
  .nav__links a[aria-current='location'] {
    color: var(--gold-strong);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Styled like the nav links: no box, soft ink, the same hover highlight. */
  .nav__icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .nav__icon-btn:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }

  :global(:root:not([data-theme='dark'])) .nav__icon-btn:hover {
    background: color-mix(in srgb, var(--bg-alt) 45%, transparent);
  }

  /* Open, like the current page's link. */
  .nav__icon-btn[aria-expanded='true'] {
    color: var(--gold-strong);
  }

  /* Icon renders its own <svg>, outside this component's style scope. */
  .nav__icon-btn :global(.icon-close) {
    display: none;
  }

  .nav.is-open .nav__icon-btn :global(.icon-open) {
    display: none;
  }

  .nav.is-open .nav__icon-btn :global(.icon-close) {
    display: block;
  }

  .nav__cta {
    display: none;
    min-height: 42px;
    padding: 9px 18px;
  }

  @media (min-width: 640px) {
    .nav__cta {
      display: inline-flex;
    }
  }

  /* Same place and slide as the settings panel (Settings.astro), but sized for
     thumbs: it fills a phone's width, grows up to 440px on tablets, and its rows
     scale with the screen so every link is an easy tap. */
  .nav__mobile {
    position: fixed;
    top: 80px;
    right: 16px;
    z-index: 60;
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100dvh - 96px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px clamp(18px, 5vw, 28px) clamp(18px, 5vw, 28px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    visibility: hidden;
    opacity: 0;
    transform: translateX(calc(100% + 24px));
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s,
      visibility 0s 0.3s;
  }

  .nav__mobile[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s;
  }

  .nav__mobile ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__mobile a:not(.btn) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: clamp(14px, 4vw, 20px) 4px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: clamp(1.15rem, 1rem + 1.2vw, 1.35rem);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__mobile a:not(.btn) :global(svg) {
    width: 22px;
    height: 22px;
  }

  .nav__mobile a:not(.btn):hover {
    color: var(--gold-strong);
  }

  .nav__mobile a[aria-current] {
    color: var(--gold-strong);
  }

  @media (min-width: 1080px) {
    .nav__links {
      display: block;
    }
    .nav__toggle,
    .nav__mobile {
      display: none;
    }
    .nav__brand {
      margin-right: 0;
    }
    .nav__links {
      margin: 0 auto;
    }
  }
</style>
