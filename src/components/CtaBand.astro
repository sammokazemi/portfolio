---
import Icon from './Icon.astro';
import Girih from './Girih.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s build something that matters.',
  text = 'Health tech, labor tech, or a project for the Iranian community: if it serves people, I want to hear about it.',
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta reveal">
      <Girih id="cta-girih" size={56} />
      <div class="cta__body">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a href={url('/contact')} class="btn cta__primary">
          Get in touch <Icon name="arrow-right" />
        </a>
        <a href={url('/resume')} class="btn cta__ghost">
          <Icon name="file-text" /> View resume
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 28px;
    align-items: center;
    padding: clamp(32px, 6vw, 64px);
    border-radius: calc(var(--radius) + 6px);
    background: linear-gradient(135deg, #142a63 0%, #0a6e6f 100%);
    color: #f3eee4;
  }

  .cta :global(.girih) {
    color: rgba(255, 255, 255, 0.08);
  }

  .cta__body,
  .cta .btn-row {
    position: relative;
  }

  .cta h2 {
    color: #fff;
    max-width: 20ch;
  }

  .cta p {
    max-width: 52ch;
    margin: 0;
    color: rgba(243, 238, 228, 0.86);
    font-size: 1.1rem;
  }

  .cta__primary {
    background: #d49a2a;
    color: #13203b;
  }

  .cta__primary:hover {
    background: #e9b64d;
    color: #13203b;
    transform: translateY(-1px);
  }

  .cta__ghost {
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
  }

  .cta__ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  @media (min-width: 900px) {
    .cta {
      grid-template-columns: 1fr auto;
    }
  }
</style>
