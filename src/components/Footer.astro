---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Girih from './Girih.astro';
import { site, socials, nav } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__band" aria-hidden="true">
    <Girih id="footer-girih" size={48} />
  </div>

  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={url('/')} class="footer__logo" aria-label="Sām Kazemi, home"><Logo /></a>
      <p>{site.tagline}</p>
      <a class="footer__email" href={`mailto:${site.email}`}>
        <Icon name="mail" size={18} />
        {site.email}
      </a>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        <li><a href={url('/')}>Home</a></li>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        <li><a href={url('/contact')}>Contact</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2>Featured work</h2>
      <ul>
        <li><a href={url('/projects/clearpath')}>ClearPath Virtual Health</a></li>
        <li><a href={url('/projects/union-workforce')}>Union Workforce Ecosystem</a></li>
        <li>
          <a href="https://clearpathvirtualhealth.com/" target="_blank" rel="noopener">
            clearpathvirtualhealth.com <Icon name="arrow-up-right" size={14} />
          </a>
        </li>
        <li>
          <a href="https://workforcesystems.net/" target="_blank" rel="noopener">
            workforcesystems.net <Icon name="arrow-up-right" size={14} />
          </a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h2>Connect</h2>
      <ul class="footer__social">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.placeholder ? undefined : '_blank'}
                rel={s.placeholder ? undefined : 'noopener me'}
                aria-label={s.placeholder ? `${s.label} (link coming soon)` : s.label}
                data-placeholder={s.placeholder ? 'true' : undefined}
              >
                <Icon name={s.icon} size={18} />
                <span>{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="footer__motto">
      <span class="persian" lang="fa">{site.persianName}</span>
      <span aria-hidden="true">·</span>
      Built with Astro in the San Francisco Bay Area
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 0;
    background: var(--surface);
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .footer__band {
    position: relative;
    height: 44px;
    overflow: hidden;
    background: linear-gradient(90deg, var(--lapis-deep), var(--turquoise-strong));
  }

  .footer__band :global(.girih) {
    color: rgba(255, 255, 255, 0.18);
  }

  .footer__grid {
    display: grid;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer__logo {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 14px;
  }

  .footer__brand p {
    max-width: 34ch;
  }

  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    word-break: break-all;
  }

  .footer__email :global(svg) {
    flex: none;
  }

  .footer__col h2 {
    margin-bottom: 14px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer__col ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--turquoise-strong);
  }

  .footer__social a :global(svg) {
    color: var(--turquoise);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    padding-bottom: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__motto {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer__motto .persian {
    line-height: 1.6;
  }
</style>
