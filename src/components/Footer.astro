---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, socials, nav } from '../data/site';
import { url } from '../lib/url';
import { splitEmail } from '../lib/text';

const year = new Date().getFullYear();
const explore = nav.slice(0, 3);
const more = nav.slice(3);
const profiles = socials.filter((s) => !s.placeholder);
const emails = [site.email, site.workEmail].map(splitEmail);
---

<footer class="footer">
  <div class="footer__band" aria-hidden="true"></div>

  <div class="footer__body">
    <div class="container footer__grid">
      <div class="footer__brand">
        <a href={url('/')} class="footer__logo" aria-label="Sām Kazemi, home"><Logo /></a>
        <p>{site.tagline}</p>
        {
          emails.map(([user, domain]) => (
            <a class="footer__email" href={`mailto:${user}${domain}`}>
              <Icon name="mail" size={18} />
              <span>{user}<wbr />{domain}</span>
            </a>
          ))
        }
        <div class="footer__profiles">
          {
            profiles.map((s) => (
              <a href={s.href} target="_blank" rel="noopener me" aria-label={`${s.label} (opens in a new tab)`}>
                <Icon name={s.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <h2>Explore</h2>
        <ul>
          <li><a href={url('/')}>Home</a></li>
          {explore.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Footer, more">
        <h2>More</h2>
        <ul>
          {more.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
          <li><a href={url('/contact')}>Contact</a></li>
        </ul>
      </nav>

      <div class="footer__col">
        <h2>Featured work</h2>
        <ul>
          <li><a href={url('/projects/clearpath')}>ClearPath Virtual Health</a></li>
          <li><a href={url('/projects/workforce-systems')}>Union Workforce Ecosystem</a></li>
          <li>
            <a href="https://clearpathvirtualhealth.com/" target="_blank" rel="noopener">
              clearpathvirtualhealth.com <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
          <li>
            <a href="https://workforcesystems.net/" target="_blank" rel="noopener">
              workforcesystems.net <Icon name="arrow-up-right" size={14} />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="container footer__bottom">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p class="footer__motto">
        <span class="old-persian" lang="peo">{site.oldPersianName}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .footer__band {
    height: 1px;
    background: var(--line);
  }

  .footer__body {
    background: var(--surface);
  }

  .footer__grid {
    display: grid;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer__logo {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 14px;
  }

  .footer__brand p {
    max-width: 34ch;
  }

  .footer__email {
    display: flex;
    width: fit-content;
    margin-top: 8px;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  /* Wraps before the @ (the <wbr>), and mid-word only if a part still can't fit. */
  .footer__email span {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .footer__email :global(svg) {
    flex: none;
  }

  .footer__profiles {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .footer__profiles a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--gold-strong);
    color: var(--gold-strong);
    background: var(--surface);
    transition: color 0.2s, border-color 0.2s;
  }

  .footer__profiles a:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .footer__col h2 {
    margin-bottom: 14px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer__col ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--gold-strong);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    padding-bottom: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__motto {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer__motto .old-persian {
    color: var(--ink-soft);
  }
</style>
