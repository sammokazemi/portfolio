---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
}

const { src, alt, widths, sizes, class: className } = Astro.props;

// Full-resolution copy for the enlarged view, as WebP rather than the source PNG.
const full = await getImage({ src, format: 'webp', width: src.width });
---

<a href={full.src} class="cs-zoom" data-zoom>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} class={className} />
  <span class="visually-hidden">(opens full size)</span>
</a>
