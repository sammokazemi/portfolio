---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import Rosettes from '../components/Rosettes.astro';
import { url } from '../lib/url';

interface Props {
  name: string;
  description: string;
  summary: string;
  role: string;
  org: string;
  period: string;
  status: string;
  live: string;
  liveLabel: string;
  stack: string[];
  accent?: 'turquoise' | 'lapis';
}

const { name, description, summary, role, org, period, status, live, liveLabel, stack, accent = 'turquoise' } =
  Astro.props;
---

<Base title={name} description={description}>
  <section class={`cs-hero cs-hero--${accent}`}>
    <div class="cs-hero__pattern" aria-hidden="true">
      <Rosettes id="cs-rosettes" size={72} />
    </div>
    <div class="container cs-hero__inner">
      <a class="cs-back reveal" href={url('/projects')}>
        <Icon name="arrow-left" size={16} /> All projects
      </a>
      <p class="eyebrow reveal">Case study</p>
      <h1 class="reveal" style="--delay: 0.05s">{name}</h1>
      <p class="lead cs-summary reveal" style="--delay: 0.1s">{summary}</p>
      <div class="btn-row reveal" style="--delay: 0.15s">
        <a class="btn btn--primary" href={live} target="_blank" rel="noopener">
          Visit {liveLabel} <Icon name="arrow-up-right" />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <div class="container">
    <dl class="cs-facts card reveal">
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Company</dt>
        <dd>{org}</dd>
      </div>
      <div>
        <dt>Timeline</dt>
        <dd>{period}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{status}</dd>
      </div>
    </dl>
  </div>

  <div class="container cs-body">
    <article class="cs-content">
      <slot />
    </article>
    <aside class="cs-aside reveal">
      <div class="card">
        <h2 class="cs-aside__title">Tech &amp; tools</h2>
        <ul class="tag-list">
          {stack.map((s) => <li class="tag">{s}</li>)}
        </ul>
      </div>
    </aside>
  </div>

  <dialog class="zoom" aria-label="Screenshot, full size" data-zoom-dialog>
    <button type="button" class="zoom__close" data-zoom-close>
      <Icon name="close" />
      <span class="visually-hidden">Close</span>
    </button>
  </dialog>
</Base>

<script>
  // Screenshots are links to their full-size image; with JS they open in a dialog instead.
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  // Created here rather than in the markup, so the page never ships an <img> without a src.
  const full = document.createElement('img');
  full.className = 'zoom__img';
  full.alt = '';
  dialog?.append(full);

  document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach((link) => {
    link.addEventListener('click', (e) => {
      // Leave new-tab and new-window clicks to the browser.
      if (!dialog || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      full.src = link.href;
      full.alt = link.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });

  // Any click closes it: the backdrop, the image, or the close button.
  dialog?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => full.removeAttribute('src'));
</script>

<style>
  .cs-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 80px) 0 clamp(96px, 12vw, 136px);
    background:
      radial-gradient(circle at 85% 20%, var(--gold-tint), transparent 55%),
      radial-gradient(circle at 10% 110%, var(--gold-tint), transparent 45%);
    border-bottom: 1px solid var(--line);
  }

  .cs-hero__pattern {
    position: absolute;
    inset: 0 0 0 40%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 60%);
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }

  .cs-hero__inner {
    position: relative;
  }

  .cs-back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cs-back:hover {
    color: var(--gold);
  }

  .cs-hero h1 {
    max-width: 16ch;
  }

  .cs-summary {
    max-width: 62ch;
    margin: 16px 0 30px;
  }

  .cs-facts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: -64px 0 0;
    box-shadow: var(--shadow);
  }

  @media (min-width: 800px) {
    .cs-facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cs-facts dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-strong);
  }

  .cs-facts dd {
    margin: 4px 0 0;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Block padding only: the inline padding is the container's gutter. */
  .cs-body {
    padding-block: clamp(48px, 7vw, 80px) clamp(56px, 8vw, 96px);
  }

  .cs-aside__title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .cs-content :global(section) {
    margin-bottom: clamp(48px, 7vw, 72px);
  }

  .cs-content :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .cs-content :global(p) {
    color: var(--ink-soft);
  }

  .cs-content :global(.cs-features) {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }

  @media (min-width: 720px) {
    .cs-content :global(.cs-features) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cs-content :global(.cs-features h3) {
    margin: 16px 0 8px;
    font-size: 1.1rem;
  }

  .cs-content :global(.cs-features p) {
    margin: 0;
    font-size: 0.975rem;
  }

  .cs-content :global(.cs-metrics) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .cs-content :global(.cs-metrics li) {
    padding: 22px;
    border-radius: var(--radius);
    background: var(--gold-tint);
  }

  .cs-content :global(.cs-metrics strong) {
    display: block;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--gold-strong);
  }

  .cs-content :global(.cs-metrics span) {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .cs-content :global(.cs-flow) {
    display: grid;
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: flow;
  }

  .cs-content :global(.cs-flow li) {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    counter-increment: flow;
  }

  .cs-content :global(.cs-flow li::before) {
    content: counter(flow);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--gold-tint);
    color: var(--ink);
    font-weight: 800;
  }

  .cs-content :global(.cs-flow strong) {
    display: block;
    color: var(--ink);
  }

  .cs-content :global(.cs-flow span) {
    color: var(--ink-soft);
    font-size: 0.975rem;
  }

  /* Product screenshots: desktop screens, rows of phone screens, and a phone laid over a desktop. */
  /* Capped so each figure, caption included, fits in one desktop viewport. */
  .cs-content :global(.cs-shot) {
    max-width: 960px;
    margin: 28px auto;
  }

  .cs-content :global(.cs-shot:has(.cs-phones)) {
    max-width: 720px;
  }

  .cs-content :global(.cs-shot:has(.cs-story)) {
    max-width: 860px;
  }

  /* Two related desktop screens side by side, using the full column. */
  .cs-content :global(.cs-shot--wide) {
    max-width: none;
  }

  .cs-content :global(.cs-pair) {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .cs-content :global(.cs-pair) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cs-content :global(.cs-shot figcaption) {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .cs-content :global(.cs-screen) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .cs-content :global(.cs-phones) {
    display: grid;
    /* minmax(0, …) so an image's natural width can never stretch a column past the page. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 2.5vw, 20px);
  }

  .cs-content :global(.cs-phone) {
    border-radius: clamp(14px, 3vw, 26px);
  }

  .cs-content :global(.cs-story) {
    position: relative;
    padding-bottom: 26%;
  }

  .cs-content :global(.cs-story__desktop) {
    width: 84%;
    margin-left: auto;
  }

  .cs-content :global(.cs-story__phone) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 27%;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.45);
  }

  /* On phones, three screens side by side are too small to read: swipe through them
     instead, bleeding to the screen edge with the next one peeking in. */
  @media (max-width: 599px) {
    .cs-content :global(.cs-phones) {
      /* Contains the links' absolutely positioned screen-reader text; without it that
         text escapes the scroller and widens the page, and phones zoom out to fit it. */
      position: relative;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 64%;
      gap: 14px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .cs-content :global(.cs-phones::-webkit-scrollbar) {
      display: none;
    }

    .cs-content :global(.cs-phones > *) {
      scroll-snap-align: start;
    }

    .cs-content :global(.cs-phones + figcaption) {
      margin-top: 0;
    }

    /* A bigger phone over the desktop, so both stay legible. */
    .cs-content :global(.cs-story) {
      padding-bottom: 61%;
    }

    .cs-content :global(.cs-story__desktop) {
      width: 88%;
    }

    .cs-content :global(.cs-story__phone) {
      width: 38%;
    }
  }

  .cs-content :global(.cs-zoom) {
    display: block;
    cursor: zoom-in;
  }

  /* The link can collapse around an absolutely placed image, so the focus ring goes on the image. */
  .cs-content :global(.cs-zoom:focus-visible) {
    outline: none;
  }

  .cs-content :global(.cs-zoom:focus-visible img) {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .zoom {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(12px, 3vw, 40px);
    border: 0;
    background: transparent;
  }

  .zoom[open] {
    display: grid;
    place-items: center;
  }

  .zoom::backdrop {
    background: rgba(10, 8, 5, 0.9);
  }

  /* Created by the script, so it has no scoped attribute. */
  .zoom :global(.zoom__img) {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 2 * clamp(12px, 3vw, 40px));
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
    cursor: zoom-out;
  }

  .zoom__close {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }

  .zoom__close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  :global(html:has(.zoom[open])) {
    overflow: hidden;
  }
</style>
