---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (and give it no canonical URL), e.g. the 404 page. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const oldPersianText = encodeURIComponent(site.oldPersianName);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#fbf8f1" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('/og/sam-kazemi-cafe.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sām Kazemi at a café table with an iced coffee" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,500&family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Noto+Sans+Old+Persian&display=swap&text=${oldPersianText}`}
    />

    <script is:inline>
      document.documentElement.classList.add('js');

      // Theme: light during the day, dark at night, by the visitor's local clock.
      // It's chosen once when a visit starts and then held for that visit (moving
      // between pages in the same tab), so it never flips while someone is on the
      // site. A pick from the navbar toggle also carries into new visits until the
      // next day/night switch. Runs in <head> so the page never flashes.
      (function () {
        var DAY_START = 7; // 7am
        var NIGHT_START = 19; // 7pm
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');

        function valid(theme) {
          return theme === 'light' || theme === 'dark';
        }

        function clock(now) {
          var h = now.getHours();
          var theme = h >= DAY_START && h < NIGHT_START ? 'light' : 'dark';
          var next = new Date(now);
          next.setHours(theme === 'light' ? NIGHT_START : DAY_START, 0, 0, 0);
          if (next <= now) next.setDate(next.getDate() + 1);
          return { theme: theme, next: next.getTime() };
        }

        function set(theme) {
          root.dataset.theme = theme;
          if (meta) meta.content = theme === 'dark' ? '#14110c' : '#fbf8f1';
          try {
            sessionStorage.setItem('theme', theme);
          } catch (e) {}
        }

        var now = new Date();
        var theme = clock(now).theme;
        try {
          var picked = JSON.parse(localStorage.getItem('theme'));
          if (picked && picked.until > now.getTime() && valid(picked.theme)) theme = picked.theme;
        } catch (e) {}
        try {
          var visit = sessionStorage.getItem('theme');
          if (valid(visit)) theme = visit;
        } catch (e) {}
        set(theme);

        // Back/forward navigation can restore this page as it was left; if the theme
        // was switched on another page since, pick that up instead of the stale one.
        window.addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          try {
            var current = sessionStorage.getItem('theme');
            if (valid(current) && current !== root.dataset.theme) set(current);
          } catch (err) {}
        });

        document.addEventListener('click', function (e) {
          if (!(e.target instanceof Element) || !e.target.closest('[data-theme-toggle]')) return;
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', JSON.stringify({ theme: next, until: clock(new Date()).next }));
          } catch (e) {}
          set(next);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
