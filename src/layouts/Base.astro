---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Settings from '../components/Settings.astro';
// Self-hosted for the "Readable font" setting; browsers only download it once it's switched on.
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (and give it no canonical URL), e.g. the 404 page. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const oldPersianText = encodeURIComponent(site.oldPersianName);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <!-- Gold so link previews (Discord's embed stripe) match the brand. Browsers
         never see it: the theme script below swaps in the page background. -->
    <meta name="theme-color" content="#c8962b" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('/og/sam-kazemi-cafe.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sām Kazemi at a café table with an iced coffee" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,500&family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Noto+Sans+Old+Persian&display=swap&text=${oldPersianText}`}
    />

    <script is:inline>
      document.documentElement.classList.add('js');

      // Theme has three modes, picked in the settings panel and saved in
      // localStorage under "theme":
      //   - light / dark: always that theme.
      //   - auto (the default, nothing saved): light during the day, dark at night,
      //     by the visitor's local clock. It's chosen once when a visit starts and
      //     held for that visit (sessionStorage), so it never flips mid-browse.
      // Runs in <head> so the page never flashes.
      //
      // The other settings (text size, motion, contrast, font, spacing, line length)
      // live in localStorage under "prefs" and become data-* attributes on <html>.
      (function () {
        var DAY_START = 7; // 7am
        var NIGHT_START = 19; // 7pm
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');

        function valid(theme) {
          return theme === 'light' || theme === 'dark';
        }

        function clockTheme() {
          var h = new Date().getHours();
          return h >= DAY_START && h < NIGHT_START ? 'light' : 'dark';
        }

        // Kept in memory too, so a pick still works when storage is blocked.
        var mode = 'auto';
        function readMode() {
          try {
            var saved = localStorage.getItem('theme');
            if (valid(saved)) return saved;
            // Anything else (including the old {theme, until} format) means auto.
            if (saved !== null) localStorage.removeItem('theme');
            return 'auto';
          } catch (e) {
            return mode;
          }
        }

        function autoTheme() {
          var theme = null;
          try {
            theme = sessionStorage.getItem('theme');
          } catch (e) {}
          if (!valid(theme)) {
            theme = clockTheme();
            try {
              sessionStorage.setItem('theme', theme);
            } catch (e) {}
          }
          return theme;
        }

        function set(theme) {
          root.dataset.theme = theme;
          if (meta) meta.content = theme === 'dark' ? '#14110c' : '#fbf8f1';
        }

        function resolve() {
          return mode === 'auto' ? autoTheme() : mode;
        }

        mode = readMode();
        set(resolve());

        // Allowed values per setting; anything else means the default.
        var PREFS = {
          textSize: ['sm', 'lg', 'xl'],
          motion: ['reduce', 'full'],
          contrast: ['more'],
          font: ['readable'],
          spacing: ['relaxed'],
          measure: ['short'],
        };
        var reduceQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;

        function applyPrefs() {
          var saved = null;
          try {
            saved = JSON.parse(localStorage.getItem('prefs'));
          } catch (e) {}
          if (!saved || typeof saved !== 'object') saved = {};
          for (var key in PREFS) {
            if (PREFS[key].indexOf(saved[key]) !== -1) root.dataset[key] = saved[key];
            else delete root.dataset[key];
          }
          // Without a choice in the panel, motion follows the device setting.
          if (!root.dataset.motion) root.dataset.motion = reduceQuery && reduceQuery.matches ? 'reduce' : 'full';
        }
        applyPrefs();
        if (reduceQuery && reduceQuery.addEventListener) reduceQuery.addEventListener('change', applyPrefs);

        // Back/forward navigation can restore this page as it was left; if the
        // settings were changed on another page since, pick those up instead.
        window.addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          mode = readMode();
          set(resolve());
          applyPrefs();
        });

        // Switching themes from the panel crossfades the whole page (see the
        // ::view-transition rules in global.css) instead of snapping. Browsers
        // without view transitions, and reduced motion, switch instantly.
        function fadeTo(theme) {
          if (theme === root.dataset.theme || !document.startViewTransition || root.dataset.motion === 'reduce') {
            set(theme);
            return;
          }
          var transition = document.startViewTransition(function () {
            set(theme);
          });
          // A transition cut short by a quicker switch rejects these promises; the
          // theme is still applied, so there's nothing to report.
          function ignore() {}
          transition.ready.catch(ignore);
          transition.finished.catch(ignore);
          transition.updateCallbackDone.catch(ignore);
        }

        // Used by the settings panel (Settings.astro).
        window.siteSettings = {
          themeMode: function () {
            return mode;
          },
          /** 'light', 'dark', or 'auto'. */
          setThemeMode: function (next) {
            if (next !== 'auto' && !valid(next)) return;
            mode = next;
            try {
              if (next === 'auto') {
                localStorage.removeItem('theme');
                // Re-check the clock now rather than reuse this visit's earlier pick.
                sessionStorage.removeItem('theme');
              } else {
                localStorage.setItem('theme', next);
              }
            } catch (e) {}
            fadeTo(resolve());
          },
          applyPrefs: applyPrefs,
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <Settings />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
